# Copia questo file in .env e compila i valori, poi: npm start
# Esempio con Gmail: crea una "Password per app" su https://myaccount.google.com/apppasswords

PORT=8787
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tuaemail@gmail.com
SMTP_PASS=password-per-app
SMTP_FROM=tuaemail@gmail.com
