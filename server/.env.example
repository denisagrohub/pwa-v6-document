# Copia questo file in .env e compila i valori, poi: npm start

# --- Esempio REGISTER.IT (caselle email register.it) ---
# Server: authsmtp.securemail.pro - porta 465 SSL
# Username: l'indirizzo email della casella (es. info@tuodominio.it)
# oppure, con il servizio "Invii aggiuntivi": smtp@tuodominio.it
PORT=8787
SMTP_HOST=authsmtp.securemail.pro
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@tuodominio.it
SMTP_PASS=password-della-casella
SMTP_FROM=info@tuodominio.it

# --- Esempio GMAIL ---
# Crea una "Password per app" su https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=tuaemail@gmail.com
# SMTP_PASS=password-per-app
# SMTP_FROM=tuaemail@gmail.com
